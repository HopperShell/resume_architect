# === LLM Configuration ===
# Choose your models (see CLAUDE.md for provider formats)
# Examples:
#   OpenAI: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
#   Anthropic: claude-3-5-sonnet-20241022, claude-3-opus-20240229
#   Google: gemini/gemini-2.5-flash, gemini/gemini-2.5-pro
#   Ollama: ollama/llama3.2, ollama/mistral
#   OpenRouter: openrouter/anthropic/claude-3.5-sonnet
#   vLLM: hosted_vllm/meta-llama/Llama-3.1-70B

LLM_MODEL_OPTIMIZE=gemini/gemini-2.5-flash
LLM_MODEL_ANALYZE=gemini/gemini-2.5-flash

# === API Keys (uncomment and set the ones you need) ===

# OpenAI
# OPENAI_API_KEY=sk-...

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini (default)
GEMINI_API_KEY=your-gemini-api-key-here

# OpenRouter (access to many models)
# OPENROUTER_API_KEY=sk-or-...

# === Local/Self-hosted Models ===

# Ollama (local)
# Note: Use host.docker.internal when running in Docker
# OLLAMA_API_BASE=http://localhost:11434

# vLLM (self-hosted)
# VLLM_API_BASE=http://your-vllm-server:8000

# === Frontend Configuration ===
REACT_APP_API_URL=http://localhost:8000
